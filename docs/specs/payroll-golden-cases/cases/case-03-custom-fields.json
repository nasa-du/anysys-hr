{
  "id": "case-03-custom-fields",
  "title": "自定义计薪项与加减项",
  "kind": "scheme",
  "covers": ["custom_field", "category_coverage", "scheme_override"],
  "engine_version": "1.0.0",
  "notes": "新增司龄补贴（earning）与夜班津贴（addon），方案覆盖 normal_pay 与 addon_sum 把两项纳入；五条校验通过。",
  "input": {
    "field_defs": [
      {
        "field_key": "seniority_pay",
        "label": "司龄补贴",
        "category": "earning",
        "calc_mode": "formula",
        "default_formula": "ROUND(100, 2)",
        "display_order": 1000
      },
      {
        "field_key": "night_shift_allowance",
        "label": "夜班津贴",
        "category": "addon",
        "calc_mode": "formula",
        "default_formula": "ROUND(ot_weekday_hours * 5, 2)",
        "display_order": 1010
      }
    ],
    "formula_overrides": {
      "normal_pay": "ROUND(base_pay + hightemp + performance + overtime_pay_actual + confidential + social_sub + noncompete_sub + seniority_pay, 2)",
      "addon_sum": "ROUND(SUM(paid_leave_pay, ot_subsidy, phone_allowance, car_allowance, other_addon, production_bonus, commission, attendance_deduct, admin_deduct, night_shift_allowance), 2)"
    },
    "values": {
      "base_salary": "5000.00",
      "hightemp_subsidy": "0.00",
      "performance_salary": "0.00",
      "overtime_pay": "0.00",
      "confidentiality_allowance": "0.00",
      "social_subsidy": "0.00",
      "noncompete_subsidy": "0.00",
      "total_package": "5000.00",
      "weekday_full": "21.0",
      "weekend_full": "9.0",
      "weekday_attended": "21.0",
      "weekend_attended": "9.0",
      "paid_leave_days": "0.0",
      "ot_weekday_hours": "10.00",
      "ot_weekend_hours": "0.00",
      "ot_holiday_hours": "0.00",
      "attendance_deduct": "0.00",
      "phone_allowance": "0.00",
      "car_allowance": "0.00",
      "other_addon": "0.00",
      "production_bonus": "0.00",
      "commission": "0.00",
      "admin_deduct": "0.00",
      "social_this": "0.00",
      "tax": "0.00",
      "paid_advance": "0.00"
    },
    "params": {
      "avg_pay_days": "21.75",
      "work_hours": "8.00",
      "ot_mult_weekday": "1.50",
      "ot_mult_weekend": "2.00",
      "ot_mult_holiday": "3.00",
      "min_wage": "2040.00",
      "tax_threshold": "5000.00",
      "tax_rate": "0.03",
      "social_rate": "0.23338"
    }
  },
  "expected": {
    "values": {
      "base_pay": "5000.00",
      "performance": "0.00",
      "overtime_pay_actual": "0.00",
      "normal_pay": "5100.00",
      "paid_leave_pay": "0.00",
      "ot_subsidy": "431.03",
      "addon_sum": "481.03",
      "gross": "5581.03",
      "deduct_sum": "0.00",
