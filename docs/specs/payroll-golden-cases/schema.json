{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nasa-du/anysys-hr/docs/specs/payroll-golden-cases/schema.json",
  "title": "Payroll Formula Golden Case",
  "description": "薪资公式引擎黄金用例。formula 用例验证单个表达式；scheme 用例验证完整字段图、默认公式、来源解析与五条类别锚定一致性校验。",
  "type": "object",
  "required": ["id", "title", "kind", "covers", "engine_version", "notes", "input", "expected"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "formula" } },
        "required": ["kind"]
      },
      "then": { "required": ["formula"] }
    },
    {
      "if": {
        "properties": { "kind": { "const": "scheme" } },
        "required": ["kind"]
      },
      "then": { "not": { "required": ["formula"] } }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^case-[0-9]{2}[a-z]?-[a-z0-9-]+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["formula", "scheme"] },
    "covers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "engine_version": { "$ref": "#/$defs/engineVersion" },
    "notes": { "type": "string" },
    "formula": { "type": "string", "minLength": 1 },
    "input": { "$ref": "#/$defs/input" },
    "expected": { "$ref": "#/$defs/expected" }
  },
  "$defs": {
    "engineVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "nullableDecimal": {
      "anyOf": [{ "$ref": "#/$defs/decimal" }, { "type": "null" }]
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "fieldDef": {
      "type": "object",
      "required": ["field_key", "label", "category", "calc_mode"],
      "additionalProperties": false,
      "properties": {
        "field_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["earning", "addon", "deduction", "total", "reference"]
        },
        "calc_mode": {
          "enum": ["plan", "import", "formula", "fixed"]
        },
        "source_key": { "$ref": "#/$defs/nullableString" },
        "default_formula": { "$ref": "#/$defs/nullableString" },
        "fixed_value": { "$ref": "#/$defs/nullableDecimal" },
        "display_order": { "type": "integer" },
        "visible": { "type": "boolean" },
        "is_system": { "type": "boolean" },
        "is_active": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field_defs": {
          "type": "array",
          "items": { "$ref": "#/$defs/fieldDef" }
        },
        "formula_overrides": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "values": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/decimal" }
        },
        "params": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/decimal" }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["value"] },
        { "required": ["values"] },
        { "required": ["error"] }
      ],
      "properties": {
        "value": { "$ref": "#/$defs/decimal" },
        "values": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/decimal" }
        },
        "error": { "$ref": "#/$defs/error" },
        "consistency": {
          "oneOf": [
            { "const": "pass" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/violation" }
            }
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "field_key": { "type": "string" },
        "position": { "type": "integer", "minimum": 0 },
        "path": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "violation": {
      "type": "object",
      "required": ["check", "expected", "actual"],
      "additionalProperties": false,
      "properties": {
        "check": {
          "enum": ["normal_pay", "addon_sum", "gross", "deduct_sum", "net"]
        },
        "expected": { "$ref": "#/$defs/decimal" },
        "actual": { "$ref": "#/$defs/decimal" }
      }
    }
  }
}
