{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nasa-du/anysys-hr/docs/specs/payroll-golden-cases/security-schema.json",
  "title": "Payroll Formula Security Corpus",
  "description": "公式安全语料：每条记录一个表达式和期望的解析/限额错误码。",
  "type": "object",
  "required": ["engine_version", "items"],
  "additionalProperties": false,
  "properties": {
    "engine_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "formula", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sec-[0-9]{2}-[a-z0-9-]+$"
          },
          "formula": { "type": "string", "minLength": 1 },
          "expected": {
            "type": "object",
            "required": ["code"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "position": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
