{
  "id": "case-05-lazy-if-and-comparisons",
  "title": "惰性 IF 与比较写法",
  "kind": "scheme",
  "covers": ["lazy_if", "comparison", "alias_normalization", "truthiness"],
  "engine_version": "1.0.0",
  "notes": "IF 只求值命中分支；= 与 <> 以及 ==/!= 别名；0 为假、非零为真。",
  "input": {
    "field_defs": [
      {
        "field_key": "r_lazy_true",
        "label": "惰性真分支",
        "category": "reference",
        "calc_mode": "formula",
        "default_formula": "IF(1 = 1, 10, 1 / 0)",
        "display_order": 1000
      },
      {
        "field_key": "r_lazy_false",
        "label": "惰性假分支",
        "category": "reference",
        "calc_mode": "formula",
        "default_formula": "IF(1 <> 2, 5, 1 / 0)",
        "display_order": 1010
      },
      {
        "field_key": "r_eq_alias",
        "label": "==别名",
        "category": "reference",
        "calc_mode": "formula",
        "default_formula": "IF(1 == 1, 7, 0)",
        "display_order": 1020
      },
      {
        "field_key": "r_ne_alias",
        "label": "!=别名",
        "category": "reference",
        "calc_mode": "formula",
        "default_formula": "IF(1 != 2, 8, 0)",
        "display_order": 1030
      },
      {
        "field_key": "r_truthy",
        "label": "非零为真",
        "category": "reference",
        "calc_mode": "formula",
        "default_formula": "IF(2, 9, 0)",
        "display_order": 1040
      },
      {
        "field_key": "r_falsy",
        "label": "零为假",
        "category": "reference",
        "calc_mode": "formula",
        "default_formula": "IF(0, 9, 0)",
        "display_order": 1050
      },
      {
        "field_key": "r_comparison",
        "label": "比较结果",
        "category": "reference",
        "calc_mode": "formula",
        "default_formula": "IF(2 > 1, 1, 0)",
        "display_order": 1060
      }
